{
  "$schema": "http://json.schemastore.org/template",
  "author": "Awahir",
  "classifications": [ "Web", "Onion", "Clean" ],
  "name": "My Clean Architecture Template",
  "identity": "My.CleanArch.Template",
  "shortName": "clean-onion",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "CleanArchitecture",
  "preferNameDirectory": true,
  "specialCustomOperations": {
    "**/*.csproj": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "style": "xml",
            "evaluate": true,
            "evaluator": "C++"
          }
        }
      ]
    }
  },
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "The target framework for the project.",
      "datatype": "choice",
      "choices": [
        {
          "choice": "net9.0",
          "description": ".NET 9 (default)"
        },
        {
          "choice": "net8.0",
          "description": ".NET 8 LTS"
        }
      ],
      "defaultValue": "net9.0",
      "replaces": "net9.0"
    }
  }
}