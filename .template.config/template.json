{
  "$schema": "http://json.schemastore.org/template",
  "author": "Awahir",
  "classifications": [ "Web", "Onion", "Clean" ],
  "name": "My Clean Architecture Template",
  "identity": "My.CleanArch.Template",
  "shortName": "clean-onion",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "CleanArchitecture",
  "preferNameDirectory": true,
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "The target framework for the project.",
      "datatype": "choice",
      "choices": [
        {
          "choice": "net10.0",
          "description": ".NET 10 LTS (default)"
        },
        {
          "choice": "net9.0",
          "description": ".NET 9"
        },
        {
          "choice": "net8.0",
          "description": ".NET 8 LTS"
        }
      ],
      "defaultValue": "net10.0",
      "replaces": "net10.0"
    }
  }
}