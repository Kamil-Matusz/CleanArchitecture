<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageType>Template</PackageType>
        <PackageId>My.CleanArchitecture.Pack</PackageId>
        <Title>Custom Clean Architecture Template</Title>
        <Authors>Awahir</Authors>
        <PackageVersion>1.0.0</PackageVersion>
        <TargetFramework>net9.0</TargetFramework>

        <IncludeContentInPack>true</IncludeContentInPack>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <ContentTargetFolders>content</ContentTargetFolders>
        <NoDefaultExcludes>true</NoDefaultExcludes>
        <PackageReleaseNotes>
## 1.0.0
- Initial release of the Clean Architecture (clean-onion) dotnet new template
- Four-layer solution: Core, Application, Infrastructure, Api
- DI extensions in each layer
- ASP.NET Core 9 Web API with OpenAPI support

Full changelog: https://github.com/Awahir/CleanArchitecture/blob/main/CHANGELOG.md
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="**\*" Exclude="**\bin\**;**\obj\**;**\.vs\**;**\.idea\**;**\.git\**;**\*.user;**\*.nupkg" />
        <Compile Remove="**\*" />
    </ItemGroup>
</Project>