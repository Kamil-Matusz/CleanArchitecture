<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageType>Template</PackageType>
        <PackageId>My.CleanArchitecture.Pack</PackageId>
        <Title>Custom Clean Architecture Template</Title>
        <Authors>Awahir</Authors>
        <PackageVersion>1.0.4</PackageVersion>
        <TargetFramework>net10.0</TargetFramework>

        <IncludeContentInPack>true</IncludeContentInPack>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <ContentTargetFolders>content</ContentTargetFolders>
        <NoDefaultExcludes>true</NoDefaultExcludes>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
        <PackageReleaseNotes>
        ## 1.0.4
        - Limit generated template output to the four Clean Architecture projects
        - Exclude repository, package, and build artifacts from generated projects

        ## 1.0.3
        - Add .NET 10 LTS support (default target framework)
        - Update NuGet package versions for all supported frameworks

        ## 1.0.1
        - Add dedicated README for NuGet package page (README.nuget.md)

        ## 1.0.0
        - Initial release of the Clean Architecture (clean-onion) dotnet new template
        - Four-layer solution: Core, Application, Infrastructure, Api
        - DI extensions in each layer
        - ASP.NET Core Web API with OpenAPI support
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <Content Include=".template.config\**\*" />
        <Content Include="CleanArchitecture.sln" />
        <Content Include="CleanArchitecture.Api\**\*" Exclude="**\bin\**;**\obj\**;**\*.user" />
        <Content Include="CleanArchitecture.Application\**\*" Exclude="**\bin\**;**\obj\**;**\*.user" />
        <Content Include="CleanArchitecture.Core\**\*" Exclude="**\bin\**;**\obj\**;**\*.user" />
        <Content Include="CleanArchitecture.Infrastructure\**\*" Exclude="**\bin\**;**\obj\**;**\*.user" />
        <None Include="README.nuget.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>