<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageType>Template</PackageType>
        <PackageId>My.CleanArchitecture.Pack</PackageId>
        <Title>Custom Clean Architecture Template</Title>
        <Authors>Awahir</Authors>
        <PackageVersion>1.0.2</PackageVersion>
        <TargetFramework>net9.0</TargetFramework>

        <IncludeContentInPack>true</IncludeContentInPack>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <ContentTargetFolders>content</ContentTargetFolders>
        <NoDefaultExcludes>true</NoDefaultExcludes>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
        <PackageReleaseNotes>
        ## 1.0.1
        - Add dedicated README for NuGet package page (README.nuget.md)

        ## 1.0.0
        - Initial release of the Clean Architecture (clean-onion) dotnet new template
        - Four-layer solution: Core, Application, Infrastructure, Api
        - DI extensions in each layer
        - ASP.NET Core 9 Web API with OpenAPI support
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="**\*"
                 Exclude="**\bin\**;**\obj\**;**\.vs\**;**\.idea\**;**\.git\**;dist\**;*.nupkg;**\*.user;CleanArchitecture.Template.csproj;README.md" />
        <None Include="README.nuget.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>